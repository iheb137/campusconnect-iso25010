# Copier en docker.env (non versionné) puis renseigner les valeurs.
DB_NAME=campusconnect
DB_USERNAME=campusconnect_user
DB_PASSWORD=changer-ce-mot-de-passe
JWT_SECRET=remplacer-par-une-cle-de-32-caracteres-minimum
ADMIN_EMAIL=admin@campusconnect.local
ADMIN_PASSWORD=Admin12345
MODERATOR_EMAIL=moderateur@campusconnect.local
MODERATOR_PASSWORD=Moderateur123
# Données de démonstration pour les tests de charge (0 = aucune)
DEMO_REQUESTS=2000
# Ports exposés sur la machine hôte (différents de l'installation locale)
DB_HOST_PORT=55432
BACKEND_HOST_PORT=8380
FRONTEND_HOST_PORT=3080
